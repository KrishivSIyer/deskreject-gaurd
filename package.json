{
  "name": "deskreject-guard",
  "version": "0.1.0",
  "private": true,
  "description": "DeskReject Guard – pre-flight auditor for academic manuscripts",
  "scripts": {
    "verify": "python -m pytest -q && python -m ruff check .",
    "lint": "python -m ruff check .",
    "lint:fix": "python -m ruff check . --fix",
    "test": "python -m pytest -q",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
